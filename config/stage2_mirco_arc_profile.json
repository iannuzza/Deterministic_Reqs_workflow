  "block_defs": {
    "Sensor-Hub": {
      "function": "Operate the Sensor Hub I2C master for external targets, including trigger/control, pad enable, data collection, and FIFO multi-mode coordination.",
      "inputs": "Primary sensing input",
      "outputs": "Analog input signal"
    },
    "ADC": {
      "entity_kind": "interface",
      "function": "Convert configured bio/optical channel inputs to samples, with register-controlled sampling periods and ADC test/debug modes.",
      "inputs": "Conditioned analog signal",
      "outputs": "Digital samples"
    },
    "ADSP": {
      "function": "Execute ADSP firmware for OTP boot/write/test and signal elaboration, using mapped program/data/register memory and soft-reset handling.",
      "inputs": "Acquired samples and configuration data",
      "outputs": "Elaborated signal data and metadata"
    },
    "Main Controller": {
      "classification": "Digital",
      "function": "Generate and receive Analog Domain control signals, perform DSP elaboration on ADC outputs, and write elaborated results to the defined addresses.",
      "inputs": "Configuration register settings, sampled data",
      "outputs": "Control state and data routing"
    },
    "Smart FIFO": {
      "function": "Provide FIFO storage and AHB/memory access in mutually exclusive Unique or Multiple modes, including sub-FIFO depth/addressing and tagged Sensor Hub data formatting.",
      "inputs": "Digital samples, FIFO mode configuration",
      "outputs": "Buffered samples and FIFO status flags"
    },
    "Regmap": {
      "function": "Implement the mapped AFE, system, and OTP registers, exposing configuration/status while enforcing reset and OTP write-protection rules.",
      "inputs": "Host read/write transactions",
      "outputs": "Register data and status fields"
    },
    "SPI interface": {
      "entity_kind": "interface",
      "function": "Provide the SPI serial access path into the I2C/SPI-to-AHB interface and register map, subject to the specified clock-domain constraint.",
      "inputs": "SPC, CS, SDI",
      "outputs": "SDO, register transaction responses"
    },
    "I2C interface": {
      "entity_kind": "interface",
      "function": "Provide the host I2C serial access path, supporting Standard, FM, FM+, and optionally HS operation with the configured device address.",
      "inputs": "SCL, SDA",
      "outputs": "I2C register transaction responses"
    },
    "IRQ logic": {
      "function": "Aggregate and route FIFO, Sensor Hub, ISPU sample-ready, software, and timer interrupt status to configured GPIO/interrupt outputs.",
      "inputs": "FIFO status, DRDY events, threshold/events",
      "outputs": "INT1, INT2"
    },
    "PMU": {
      "function": "Sequence POR-driven LDO1V8 enable, 64/32 kHz and 16 MHz clocks, clock-ready signaling, and digital-reset release for boot and power modes.",
      "inputs": "VDD/VDD_IO, power-on reset, clock references, clock-start requests, power-mode configuration",
      "outputs": "LDO and power-domain controls, clock enable/gating and ready status, reset-release signals, power-state status"
    },
    "BIST Controller": {
      "entity_kind": "concrete_block",
      "function": "Control BIST operating modes and coordinate ADC/OTP test operations and their register-visible results.",
      "inputs": "Self-test commands and calibration settings",
      "outputs": "Calibration/self-test status"
    },
    "I2C_SPI_AHB": {
      "function": "Accept I2C/SPI accesses and translate them as needed into AHB transactions for device configuration and readback, including ISPU access.",
      "inputs": "Host bus transactions",
      "outputs": "Protocol-compliant responses"
    },
    "OTP": {
      "function": "Provide the source-specified one-time-programmable memory interface used by ADSP boot, programming, and test routines.",
      "inputs": "OTP control, address, bank selection, programming, trim, voltage, and current-reference signals",
      "outputs": "OTP read data and status"
    },
    "PAD MUX": {
      "function": "Route source-specified functional, scan, BIST, debug, and ISPU-debug signals to and from device pads.",
      "inputs": "Mode selection, register-map controls, test controls, and internal block outputs",
      "outputs": "Pad controls, test observations, and routed internal signals"
    },
    "Unassigned": {
      "entity_kind": "unassigned",
      "function": "Placeholder for requirements requiring manual architectural assignment.",
      "inputs": "N/A",
      "outputs": "N/A"
    }
  },
